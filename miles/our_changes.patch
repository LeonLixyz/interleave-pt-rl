+        """Call a transactional weight-update endpoint when the server supports it.
+
+        SGLang versions before the begin/update/end protocol do not expose
+        these routes. Cache a 404/405 as a legacy capability result so their
+        non-transactional update endpoints continue to work unchanged.
+        """
+        if getattr(self, "_weight_update_sessions_supported", None) is False:
+            return {
